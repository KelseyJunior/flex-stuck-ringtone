{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "types": [
      "jest",
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "demo",
    "e2e",
    "playwright.config.ts"
  ]
}
